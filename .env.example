# Copy to .env (git-ignored) and fill in the real feed URLs.
# Each CAL_<ID>_URL declares one calendar (webcal:// links are accepted).
# CAL_<ID>_NAME and CAL_<ID>_COLOR are optional: the feed's own name and a default color are used otherwise.

CAL_GUILLAUME_URL=webcal://pXX-caldav.icloud.com/published/2/…
#CAL_GUILLAUME_NAME=Guillaume
CAL_GUILLAUME_COLOR=#1badf8

CAL_FAMILIAL_URL=webcal://pXX-caldav.icloud.com/published/2/…
#CAL_FAMILIAL_NAME=Familial
CAL_FAMILIAL_COLOR=#ffcc00
